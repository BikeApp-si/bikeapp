#!/bin/sh
# Bike's commands on the server (docs/install.md):
#   docker compose exec web bike backup                      a backup now, into ./backups
#   docker compose run --rm web bike restore backups/<file>  into a Bike with no company yet, web and worker stopped
set -e
if [ "$(id -u)" = 0 ]; then HOME=/home/node exec setpriv --reuid=node --regid=node --init-groups -- sh "$0" "$@"; fi
cd /app
case "$1" in
  backup|restore) exec pnpm -s exec tsx server/instance/backup-cli.ts "$@" ;;
  *) echo "Usage: bike backup | bike restore backups/<file>" >&2; exit 2 ;;
esac
