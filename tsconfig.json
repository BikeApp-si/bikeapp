{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "skipLibCheck": true,
    "allowJs": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/edition": [
        "./server/edition/open.ts"
      ],
      "@/*": [
        "./*"
      ]
    },
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-bundle-check/types/**/*.ts",
    ".next-bundle-check/dev/types/**/*.ts",
    ".next-probe/types/**/*.ts",
    ".next-probe/dev/types/**/*.ts",
    ".next-single/types/**/*.ts",
    ".next-single/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "tmp",
    ".next-e2e",
    ".next-single"
  ]
}
