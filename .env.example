# Bike's settings. Copy this file to .env, next to compose.yaml, and fill it in. Keep .env private: it holds
# Bike's passwords and keys. After a change, run `docker compose up -d` to restart Bike with it.

# Bike's address, as people type it. Use https wherever you can: from your own proxy or load balancer, or from
# Caddy beside Bike (`docker compose --profile https up -d`, docs/install.md).
INSTANCE_URL=https://bike.example.com

# The port on this machine Bike answers on (your proxy sends Bike's address here). With Caddy, set it to
# 127.0.0.1:3000 so Bike answers only through Caddy.
BIKE_PORT=3000

# Passwords for Bike's database: two long random values, made once (for example `openssl rand -hex 24`).
# DB_PASSWORD owns the database; APP_DB_PASSWORD is the one Bike works with.
DB_PASSWORD=
APP_DB_PASSWORD=

# Signs people's sessions: one more long random value, kept the same from then on (`openssl rand -hex 32`).
SESSION_SECRET=

# Your mail relay, for sign-in codes and Bike's emails: smtp://user:password@host:587 (or smtps://…:465).
# Left empty, nothing is emailed: admins find their sign-in codes in Bike's log, and no one else can sign in.
SMTP_URL=
# Who Bike's emails come from, on a domain your relay may send for.
EMAIL_FROM=Bike <bike@example.com>

# Your company's Anthropic key, to build and change apps from words. Easier: add it in Bike, in Settings › AI (that one
# wins). Left empty in both, everything else works.
ANTHROPIC_API_KEY=

# The version of Bike to run. update.sh changes it (`sh update.sh 0.6.1`), and sets it back to go back.
BIKE_VERSION=0.6.0

# Once a day Bike asks GitHub whether a newer version is out, and Settings › Instance says so. Nothing about your
# company is sent. off: never asks.
UPDATE_CHECK=on
