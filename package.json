{
  "name": "bike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:up": "docker compose -f compose.dev.yaml up -d",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx seed/index.ts",
    "db:reset": "tsx db/reset.ts",
    "worker": "tsx server/jobs/worker.ts",
    "ai:record": "tsx scripts/ai-record.ts",
    "gallery:check": "tsx scripts/gallery-check.ts",
    "db:check": "tsx scripts/check-db.ts",
    "bench:seed": "tsx scripts/bench-seed.ts",
    "bench": "tsx scripts/bench.ts",
    "e2e:single": "playwright test --config playwright.single.config.ts",
    "licences:check": "tsx scripts/licences.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "country-to-currency": "3.0.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.2",
    "geist": "1.8.2",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg-boss": "12.37.1",
    "playwright-core": "1.64.1",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
